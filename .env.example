# ── Web (apps/web) ──────────────────────────────────────────────────────────────
# Phase: "testnet" or "production"
VITE_PHASE=testnet

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_ANON_KEY=

# Solana RPC (optional — overrides per-phase default)
VITE_SOLANA_RPC_URL=
VITE_MAINNET_RPC_URL=

# Cusp Protocol — on-chain addresses (devnet)
VITE_CUSDC_MINT=
VITE_VAULT_USDC_ACCOUNT=
VITE_VAULT_PUBLIC_KEY=
VITE_TEST_USDC_MINT=
VITE_VAULT_PROGRAM_ID=
VITE_LEVERAGE_PROGRAM_ID=
VITE_EARN_VAULT_PROGRAM_ID=

# DFlow WebSocket URL (frontend)
VITE_DFLOW_WS_URL=wss://prediction-markets-api.dflow.net/api/v1/ws

# Local dev only — skips invite gate
# VITE_SKIP_INVITE_GATE=true

# ── API (apps/api) ──────────────────────────────────────────────────────────────
# Server port
PORT=4000

# DFlow API (server-side only — never prefix with VITE_)
DFLOW_API_KEY=your-dflow-api-key
DFLOW_METADATA_BASE=https://prediction-markets-api.dflow.net
DFLOW_TRADE_BASE=https://quote-api.dflow.net
DFLOW_WS_URL=wss://prediction-markets-api.dflow.net/api/v1/ws

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Supabase (admin access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Vault Keypair (JSON array of 64 bytes)
VAULT_KEYPAIR=
CUSDC_MINT=
CUSDT_MINT=

# Invite system
INVITE_SECRET=
